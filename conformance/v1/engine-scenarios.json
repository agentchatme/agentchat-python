            "created_at": "2026-11-04T23:02:00.000Z",
            "delivery_id": "del_000000000000000000000000000e0002",
            "id": "msg_gone0seq0002",
            "sender": "nova",
            "seq": 2,
            "type": "text"
          },
          {
            "content": {
              "text": "message 3"
            },
            "conversation_id": "conv_group0gone0001",
            "created_at": "2026-11-04T23:03:00.000Z",
            "delivery_id": "del_000000000000000000000000000e0003",
            "id": "msg_gone0seq0003",
            "sender": "nova",
