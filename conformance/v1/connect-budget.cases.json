{
  "about": "Connect budget (contract v1, D8). Over its per-agent connect budget the server answers the WebSocket upgrade with HTTP 429 and Retry-After, or closes the socket with 1013 and a retry hint in the close reason after the HELLO. Either way the client backs off for the server's delay; it never goes blocked. Cases give the event and the delay the next attempt waits; delay_ms null means the ordinary reconnect backoff applies.",
  "cases": [
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": "connect budget exceeded; retry_after=37"
      },
      "expect": {
        "blocked": false,
        "delay_ms": 37000
      },
      "name": "close-1013-with-a-hint"
    },
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": "Retry-After: 12"
      },
      "expect": {
        "blocked": false,
        "delay_ms": 12000
      },
      "name": "close-1013-hint-with-a-dash-and-colon"
    },
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": "Try Again Later"
      },
      "expect": {
        "blocked": false,
        "delay_ms": 60000
      },
      "name": "close-1013-without-a-hint"
    },
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": ""
      },
      "expect": {
        "blocked": false,
        "delay_ms": 60000
      },
      "name": "close-1013-with-an-empty-reason"
    },
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": "retry_after=0"
      },
      "expect": {
        "blocked": false,
        "delay_ms": 1000
      },
      "name": "close-1013-hint-zero-is-the-floor"
    },
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": "retry_after=86400"
      },
      "expect": {
        "blocked": false,
        "delay_ms": 3600000
      },
      "name": "close-1013-huge-hint-is-capped"
    },
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": "invalid token; retry_after=5"
      },
      "expect": {
        "blocked": false,
        "delay_ms": 5000
      },
      "name": "close-1013-never-blocked"
    },
    {
      "event": {
        "kind": "upgrade",
        "retry_after": "30",
        "status": 429
      },
      "expect": {
        "blocked": false,
        "delay_ms": 30000
      },
      "name": "upgrade-429-delta-seconds"
    },
    {
      "event": {
        "kind": "upgrade",
        "now": "2026-11-08T12:00:00.000Z",
        "retry_after": "Sun, 08 Nov 2026 12:00:45 GMT",
        "status": 429
      },
      "expect": {
        "blocked": false,
        "delay_ms": 45000
      },
      "name": "upgrade-429-http-date"
    },
    {
      "event": {
        "kind": "upgrade",
        "retry_after": null,
        "status": 429
      },
      "expect": {
        "blocked": false,
        "delay_ms": 60000
      },
      "name": "upgrade-429-without-retry-after"
    },
    {
      "event": {
        "kind": "upgrade",
        "retry_after": "soon",
        "status": 429
      },
      "expect": {
        "blocked": false,
        "delay_ms": 60000
      },
      "name": "upgrade-429-unusable-retry-after"
    },
    {
      "event": {
        "code": 1006,
        "kind": "close",
        "reason": ""
      },
      "expect": {
        "blocked": false,
        "delay_ms": null
      },
      "name": "close-1006-is-the-ordinary-backoff"
    },
    {
      "event": {
        "code": 1011,
        "kind": "close",
        "reason": "retry_after=30"
      },
      "expect": {
        "blocked": false,
        "delay_ms": null
      },
      "name": "close-1011-is-the-ordinary-backoff"
    }
  ],
  "default_delay_ms": 60000,
  "max_delay_ms": 3600000,
  "min_delay_ms": 1000,
  "rules": {
    "bounds": "The delay is clamped to [min_delay_ms, max_delay_ms].",
    "close_1013": "The hint is the first \"retry_after\" (or \"retry-after\"), case-insensitive, followed by \"=\", \":\" or spaces and whole seconds. No hint: default_delay_ms.",
    "jitter": "A client may wait up to 10% longer than delay_ms, never less.",
    "state": "The client is in backoff (never blocked) until the attempt; the next attempt is a normal connect.",
    "upgrade_429": "Retry-After per RFC 9110: whole seconds, or an HTTP date measured from now. Missing or unusable: default_delay_ms."
  }
}
