{
  "about": "Connect budget (contract v1, D8). Over its per-agent connect budget the server accepts the WebSocket upgrade and closes the socket with 1013 and a retry hint in the close reason (\"rate_limited; retry_after=<seconds>\"), on both auth paths. The client backs off for the server's delay; it never goes blocked. Cases give the close and the delay the next attempt waits; delay_ms null means the ordinary reconnect backoff applies. (An upgrade answered with an HTTP status, 429 included, takes the ordinary backoff: no server answers that way, and a client only tolerates it.)",
  "cases": [
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": "connect budget exceeded; retry_after=37"
      },
      "expect": {
        "blocked": false,
        "delay_ms": 37000
      },
      "name": "close-1013-with-a-hint"
    },
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": "rate_limited; retry_after=42"
      },
      "expect": {
        "blocked": false,
        "delay_ms": 42000
      },
      "name": "close-1013-as-the-server-sends-it"
    },
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": "Retry-After: 12"
      },
      "expect": {
        "blocked": false,
        "delay_ms": 12000
      },
      "name": "close-1013-hint-with-a-dash-and-colon"
    },
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": "overload"
      },
      "expect": {
        "blocked": false,
        "delay_ms": null
      },
      "name": "close-1013-overload-is-the-ordinary-backoff"
    },
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": "Try Again Later"
      },
      "expect": {
        "blocked": false,
        "delay_ms": null
      },
      "name": "close-1013-without-a-hint-is-the-ordinary-backoff"
    },
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": ""
      },
      "expect": {
        "blocked": false,
        "delay_ms": null
      },
      "name": "close-1013-with-an-empty-reason-is-the-ordinary-backoff"
    },
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": "retry_after=0"
      },
      "expect": {
        "blocked": false,
        "delay_ms": 1000
      },
      "name": "close-1013-hint-zero-is-the-floor"
    },
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": "retry_after=86400"
      },
      "expect": {
        "blocked": false,
        "delay_ms": 3600000
      },
      "name": "close-1013-huge-hint-is-capped"
    },
    {
      "event": {
        "code": 1013,
        "kind": "close",
        "reason": "invalid token; retry_after=5"
      },
      "expect": {
        "blocked": false,
        "delay_ms": 5000
      },
      "name": "close-1013-never-blocked"
    },
    {
      "event": {
        "code": 1006,
        "kind": "close",
        "reason": ""
      },
      "expect": {
        "blocked": false,
        "delay_ms": null
      },
      "name": "close-1006-is-the-ordinary-backoff"
    },
    {
      "event": {
        "code": 1011,
        "kind": "close",
        "reason": "retry_after=30"
      },
      "expect": {
        "blocked": false,
        "delay_ms": null
      },
      "name": "close-1011-is-the-ordinary-backoff"
    }
  ],
  "max_delay_ms": 3600000,
  "min_delay_ms": 1000,
  "rules": {
    "bounds": "The delay is clamped to [min_delay_ms, max_delay_ms].",
    "close_1013": "The hint is the first \"retry_after\" (or \"retry-after\"), case-insensitive, followed by \"=\", \":\" or spaces and whole seconds; the server sends \"rate_limited; retry_after=<seconds>\". A 1013 without a hint is not a budget answer (the server also closes a slow consumer with 1013 \"overload\"): the ordinary reconnect backoff applies, as before contract v1.",
    "jitter": "A client may wait up to 10% longer than delay_ms, never less.",
    "state": "The client is in backoff (never blocked) until the attempt; the next attempt is a normal connect."
  }
}
